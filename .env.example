# Required for AI fallback when a query is not in data/seed-rulings.json.
# Server-only. Never prefix with NEXT_PUBLIC_ — that would ship the key to the browser.
# Set the same name in Vercel → Project Settings → Environment Variables
# for Production, Preview, and Development.
# GET /api/health reports openRouterKeyPresent: true/false and does not return this value.
OPENROUTER_API_KEY=

# Optional. Production on Vercel uses google/gemini-2.5-flash-lite.
# Leave unset to use the repo fallback (nvidia/nemotron-3-ultra-550b-a55b:free),
# which is local/dev only — do not treat :free models as the production primary.
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Read token for the private package @yasserzakywafaa/client-core on GitHub Packages.
# Required for yarn install (local and on Vercel). Not used at runtime.
# GITHUB_PACKAGES_TOKEN=
